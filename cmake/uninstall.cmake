set(manifest "${CMAKE_CURRENT_LIST_DIR}/install_manifest.txt")
if(NOT EXISTS "${manifest}")
    message(FATAL_ERROR "Missing ${manifest}. Install from this build directory before uninstalling.")
endif()

file(STRINGS "${manifest}" installed_files)
foreach(installed_file IN LISTS installed_files)
    if(installed_file STREQUAL "")
        continue()
    endif()
    if(NOT IS_ABSOLUTE "${installed_file}")
        message(FATAL_ERROR "Expected an absolute path in ${manifest}: ${installed_file}")
    endif()
    set(path "$ENV{DESTDIR}${installed_file}")
    # Never remove directories recursively: they may contain user files.
    if(IS_DIRECTORY "${path}" AND NOT IS_SYMLINK "${path}")
        message(FATAL_ERROR "Refusing to remove directory listed in ${manifest}: ${path}")
    endif()
    if(EXISTS "${path}" OR IS_SYMLINK "${path}")
        message(STATUS "Removing ${path}")
        file(REMOVE "${path}")
        if(EXISTS "${path}" OR IS_SYMLINK "${path}")
            message(FATAL_ERROR "Could not remove ${path}. Check permissions (sudo may be required).")
        endif()
    else()
        message(STATUS "Already absent: ${path}")
    endif()
endforeach()
